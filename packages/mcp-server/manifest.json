{
  "dxt_version": "0.2",
  "name": "indicesio-mcp",
  "version": "0.2.0",
  "description": "The official MCP Server for the Indices API",
  "author": {
    "name": "Indices",
    "email": "support@indices.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indicesio/indices-typescript.git"
  },
  "homepage": "https://github.com/indicesio/indices-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.indices.io",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ],
      "env": {
        "INDICES_API_KEY": "${user_config.INDICES_API_KEY}"
      }
    }
  },
  "user_config": {
    "INDICES_API_KEY": {
      "title": "api_key",
      "description": "Enter your API key as the bearer token. Set header: `Authorization` to `Bearer <api_key>`",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "api"
  ]
}
